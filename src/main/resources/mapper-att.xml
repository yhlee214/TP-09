<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-att">
	<select id="getAttByPartyNo" parameterType="int" resultType="lx.edu.gonggu.to.AttendanceTO">
		select att_no,
		 	   att_qty,
		 	   att_datetime,
		 	   att_status,
		 	   party_no,
		 	   user_no
		from attendance 
		where party_no = {no}
	</select>

</mapper>